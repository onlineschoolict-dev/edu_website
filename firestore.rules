rules_version = '2';

function isAdmin() {
  return request.auth != null
         && request.auth.token.email == 'onlineschoolict@gmail.com'
         && request.auth.token.email_verified == true;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (request.auth != null && resource != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if request.auth != null
                  && resource != null
                  && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null
                             && request.resource.data.userId == request.auth.uid
                             && progressId == request.auth.uid + '_' + request.resource.data.courseId;
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /liveClasses/{liveId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && reviewId == request.resource.data.courseId + '_' + request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() > 0;
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId
                        && request.resource.data.courseId == resource.data.courseId
                        && request.resource.data.status == 'pending'
                        && request.resource.data.rating >= 1
                        && request.resource.data.rating <= 5
                        && request.resource.data.comment is string
                        && request.resource.data.comment.size() > 0);
      allow delete: if isAdmin();
    }

    match /liveComments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.liveClassId is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin()
                    || (request.auth != null && resource.data.userId == request.auth.uid);
    }
  }
}
