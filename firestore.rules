rules_version = '2';

function isAdmin() {
  return request.auth != null && request.auth.token.email == 'onlineschoolict@gmail.com';
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin();

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAdmin();
        }
      }
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (request.auth != null && resource != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /progress/{progressId} {
      allow read: if request.auth != null
                  && resource != null
                  && resource.data.userId == request.auth.uid;
      allow create, update: if request.auth != null
                             && request.resource.data.userId == request.auth.uid
                             && progressId == request.auth.uid + '_' + request.resource.data.courseId;
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /liveClasses/{liveId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
