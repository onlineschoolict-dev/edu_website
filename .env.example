# --- App mode (leave blank/unset for the student site) ---
# Set this to "admin" ONLY in the separate admin deployment's environment
# variables (e.g. a second Vercel project for admin.yourdomain.com).
VITE_APP_MODE=

# --- Firebase (client-side, browser-safe) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The email address that should have admin access (your own gmail is fine)
VITE_ADMIN_EMAIL=onlineschoolict@gmail.com

# --- Cloudinary (client-side, browser-safe) ---
# Used for hero/course image uploads instead of Firebase Storage, so no
# billing card is ever required. Free account: https://cloudinary.com/users/register/free
# Cloud name: Dashboard home page.
# Upload preset: Settings -> Upload -> Upload presets -> Add upload preset
#                -> Signing Mode: "Unsigned" -> Save, then copy its name here.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- Firebase Admin SDK (server-side only, used by /api functions) ---
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- SSLCommerz (sandbox is free — https://developer.sslcommerz.com/registration/) ---
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_IS_LIVE=false

# Your deployed site URL (used to build payment redirect links), e.g. https://coaching-app.vercel.app
PUBLIC_SITE_URL=
